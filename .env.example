# Axiom OS — Local-First Environment Configuration
# Copy this file to backend/.env if you wish to customize defaults.
# The application works out-of-the-box with zero configuration using SQLite and local Ollama.

APP_NAME="Axiom OS"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000

# Database (SQLite + FTS5 by default; PostgreSQL URI supported)
DATABASE_URL="sqlite:///./axiom.db"

# Primary Local AI Provider (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_OLLAMA_MODEL="qwen3.5:4b"

# Optional Cloud AI Provider (Disabled by default; requires explicit opt-in)
ALLOW_CLOUD_AI="false"
GEMINI_API_KEY=""
DEFAULT_GEMINI_MODEL="gemini-2.5-flash"

# Optional Resource Discovery API Keys (Public endpoints work without keys)
GITHUB_TOKEN=""
YOUTUBE_API_KEY=""
OPENALEX_MAILTO="researcher@axiom-local.os"

# Optional Obsidian Local REST API Integration
OBSIDIAN_REST_URL="http://127.0.0.1:27123"
OBSIDIAN_API_TOKEN=""
OBSIDIAN_DEFAULT_VAULT="Learning OS"
OBSIDIAN_APPROVED_FOLDER=""

# Optional Local n8n Automation Layer
N8N_BASE_URL="http://127.0.0.1:5678"
N8N_WEBHOOK_SECRET="axiom-local-webhook-secret"
